{
    "version": 2,
    "framework": "create-react-app",
    "buildCommand": "npm run build",
    "outputDirectory": "build",

    "redirects": [
        {
            "source": "/",
            "destination": "/study",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/post/:postId",
            "destination": "/api/ssr?postId=:postId"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}