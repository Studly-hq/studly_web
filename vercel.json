{
    "version": 2,

    "redirects": [
        {
            "source": "/",
            "destination": "/study",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/post/:postId",
            "destination": "/api/ssr?postId=:postId"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}